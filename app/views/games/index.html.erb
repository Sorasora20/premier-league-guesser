<div class="game-container">
  <h1>Premier League Guesser 26/27</h1>
  
  <% if flash[:alert] %>
    <div class="alert"><%= flash[:alert] %></div>
  <% end %>

  <% if @game_won %>
    <div class="success">
      <h2>Congratulations! You guessed the player!</h2>
      <%= button_to "Play Again", games_reset_path, method: :post, class: "btn" %>
    </div>
  <% elsif @player_revealed %>
    <div class="success">
      <h2>The player is <%= @answer_player.name %></h2>
      <%= button_to "Play Again", games_reset_path, method: :post, class: "btn" %>
    </div>
  <% else %>
    <div class="guess-form">
      <%= button_to "Reveal Answer", games_reveal_path, method: :post, class: "btn" %>
      <%= form_with url: games_guess_path, method: :post, local: true do |f| %>
        <%= f.text_field :player_name, list: "player-names", placeholder: "Guess a player...", required: true, autocomplete: "off", class: "input-field" %>
        <datalist id="player-names">
          <% @players.each do |player| %>
            <option value="<%= player.name %>">
          <% end %>
        </datalist>
        <%= f.submit "Guess", class: "btn" %>
      <% end %>
    </div>
  <% end %>

  <div class="guesses-container">
    <%= form_with url: games_hint_path, method: :post, local: true do |f| %>
      <div class="guesses-header">
        <div class="header-cell">Name</div>
        <%= f.button @revealed_hints['nationality'] || "Nationality", type: "submit", name: "attribute", value: "nationality", class: "header-cell hint-btn #{@revealed_hints['nationality'] ? 'revealed' : 'tooltip-container'}", disabled: @revealed_hints['nationality'].present?, data: { tooltip: "Click to reveal" } %>
        <%= f.button @revealed_hints['club'] || "Club", type: "submit", name: "attribute", value: "club", class: "header-cell hint-btn #{@revealed_hints['club'] ? 'revealed' : 'tooltip-container'}", disabled: @revealed_hints['club'].present?, data: { tooltip: "Click to reveal" } %>
        <%= f.button @revealed_hints['position'] || "Position", type: "submit", name: "attribute", value: "position", class: "header-cell hint-btn #{@revealed_hints['position'] ? 'revealed' : 'tooltip-container'}", disabled: @revealed_hints['position'].present?, data: { tooltip: "Click to reveal" } %>
        <%= f.button @revealed_hints['height'] || "Height", type: "submit", name: "attribute", value: "height", class: "header-cell hint-btn #{@revealed_hints['height'] ? 'revealed' : 'tooltip-container'}", disabled: @revealed_hints['height'].present?, data: { tooltip: "Click to reveal" } %>
        <%= f.button @revealed_hints['age'] || "Age", type: "submit", name: "attribute", value: "age", class: "header-cell hint-btn #{@revealed_hints['age'] ? 'revealed' : 'tooltip-container'}", disabled: @revealed_hints['age'].present?, data: { tooltip: "Click to reveal" } %>
        <%= f.button @revealed_hints['foot'] || "Foot", type: "submit", name: "attribute", value: "foot", class: "header-cell hint-btn #{@revealed_hints['foot'] ? 'revealed' : 'tooltip-container'}", disabled: @revealed_hints['foot'].present?, data: { tooltip: "Click to reveal" } %>
      </div>
    <% end %>

    <% @guesses.reverse_each do |guess| %>
      <div class="guess-row">
        <!-- Name -->
        <div class="guess-cell <%= guess.name == @answer_player.name ? 'match' : 'mismatch' %>">
          <%= guess.name %>
        </div>
        
        <!-- Nationality -->
        <div class="guess-cell <%= guess.nationality == @answer_player.nationality ? 'match' : 'mismatch' %>">
          <%= guess.nationality %>
        </div>
        
        <!-- Club -->
        <div class="guess-cell <%= guess.club == @answer_player.club ? 'match' : 'mismatch' %>">
          <%= guess.club %>
        </div>
        
        <!-- Position -->
        <div class="guess-cell <%= guess.position == @answer_player.position ? 'match' : 'mismatch' %>">
          <%= guess.position %>
        </div>
        
        <!-- Height -->
        <% if guess.height == @answer_player.height %>
          <div class="guess-cell match"><%= guess.height %></div>
        <% else %>
          <div class="guess-cell mismatch">
            <%= guess.height %> <%= guess.height > @answer_player.height ? "↓" : "↑" %>
          </div>
        <% end %>
        
        <!-- Age -->
        <% if guess.age == @answer_player.age %>
          <div class="guess-cell match"><%= guess.age %></div>
        <% else %>
          <div class="guess-cell mismatch">
            <%= guess.age %> <%= guess.age > @answer_player.age ? "↓" : "↑" %>
          </div>
        <% end %>
        
        <!-- Preferred Foot -->
        <div class="guess-cell <%= guess.preferred_foot == @answer_player.preferred_foot ? 'match' : 'mismatch' %>">
          <%= guess.preferred_foot %>
        </div>
      </div>
    <% end %>
  </div>
</div>
